{
  "name": "likemyproduct-monorepo",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build main",
    "build:auth": "nest build auth",
    "build:all": "nest build main && nest build auth",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start:main": "nest start main",
    "start:auth": "nest start auth",
    "start:dev:main": "nest start main --watch",
    "start:dev:auth": "nest start auth --watch",
    "start:debug:main": "nest start main --debug --watch",
    "start:prod:main": "node dist/apps/main/main",
    "start:all": "concurrently \"nest start main\" \"nest start auth\"",
    "start:dev:all": "concurrently \"nest start main --watch\" \"nest start auth --watch\"",
    "start": "nest start --watch",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e:main": "jest --config ./apps/main/test/jest-e2e.json",
    "test:e2e:auth": "jest --config ./apps/auth/test/jest-e2e.json",
    "clear-cache": "npx nx reset clear-cache",
    "build:sequence": " npx nx run-many --target build --all --skip-nx-cache"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.26",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.26",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "concurrently": "^9.1.2",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "stripe": "^20.4.0",
    "twilio": "^6.0.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "webpack": "^5.94.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "moduleNameMapping": {
      "^@hichandra/(.*)": "<rootDir>/libs/$1/src"
    },
    "roots": [
      "<rootDir>/libs/",
      "<rootDir>/apps/"
    ],
    "moduleNameMapper": {
      "^@hichandra/billing(|/.*)$": "<rootDir>/libs/billing/src/$1",
      "^@hichandra/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@hichandra/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@hichandra/dtos(|/.*)$": "<rootDir>/libs/dtos/src/$1",
      "^@hichandra/email-services(|/.*)$": "<rootDir>/libs/email-services/src/$1",
      "^@hichandra/repositories(|/.*)$": "<rootDir>/libs/repositories/src/$1",
      "^@hichandra/s3(|/.*)$": "<rootDir>/libs/s3/src/$1",
      "^@hichandra/gateway(|/.*)$": "<rootDir>/libs/gateway/src/$1",
      "^@hichandra/payment(|/.*)$": "<rootDir>/libs/payment/src/$1"
    }
  }
}
