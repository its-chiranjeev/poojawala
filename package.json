{
  "name": "poojawala-monorepo",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build auth-service && nest build user-service && nest build payment-service",
    "build:auth": "nest build auth-service",
    "build:user": "nest build user-service",
    "build:payment": "nest build payment-service",
    "build:all": "nest build auth-service && nest build user-service && nest build payment-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start:auth": "nest start auth-service",
    "start:user": "nest start user-service",
    "start:payment": "nest start payment-service",
    "start:dev:auth": "nest start auth-service --watch",
    "start:dev:user": "nest start user-service --watch",
    "start:dev:payment": "nest start payment-service --watch",
    "start:prod:auth": "node dist/apps/auth-service/main",
    "start:prod:user": "node dist/apps/user-service/main",
    "start:prod:payment": "node dist/apps/payment-service/main",
    "start:all": "concurrently \"nest start auth-service\" \"nest start user-service\" \"nest start payment-service\"",
    "start:dev:all": "concurrently \"nest start auth-service --watch\" \"nest start user-service --watch\" \"nest start payment-service --watch\"",
    "proxy": "node proxy.js",
    "ngrok": "ngrok http 9001",
    "dev:with-proxy": "concurrently \"npm run start:dev:all\" \"node proxy.js\"",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js --env production",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "start": "nest start --watch",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e:auth": "jest --config ./apps/auth-service/test/jest-e2e.json",
    "test:e2e:user": "jest --config ./apps/user-service/test/jest-e2e.json",
    "test:e2e:payment": "jest --config ./apps/payment-service/test/jest-e2e.json",
    "clear-cache": "npx nx reset clear-cache",
    "build:sequence": "npx nx run-many --target build --all --skip-nx-cache"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.26",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.26",
    "@sendgrid/mail": "^8.1.6",
    "@types/http-proxy": "^1.17.17",
    "@vercel/blob": "^2.8.0",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "concurrently": "^9.1.2",
    "http-proxy": "^1.18.1",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "puppeteer": "^25.4.0",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.28.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "stripe": "^20.4.0",
    "twilio": "^6.0.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "webpack": "^5.94.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/libs/",
      "<rootDir>/apps/"
    ],
    "moduleNameMapper": {
      "^@poojawala/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@poojawala/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@poojawala/dtos(|/.*)$": "<rootDir>/libs/dtos/src/$1",
      "^@poojawala/email-services(|/.*)$": "<rootDir>/libs/email-services/src/$1",
      "^@poojawala/entities(|/.*)$": "<rootDir>/libs/entities/src/$1",
      "^@poojawala/repositories(|/.*)$": "<rootDir>/libs/repositories/src/$1",
      "^@poojawala/s3(|/.*)$": "<rootDir>/libs/s3/src/$1",
      "^@poojawala/sms-services(|/.*)$": "<rootDir>/libs/sms-services/src/$1",
      "^@poojawala/gateway(|/.*)$": "<rootDir>/libs/gateway/src/$1",
      "^@poojawala/notification(|/.*)$": "<rootDir>/libs/notification/src/$1",
      "^@hichandra/billing(|/.*)$": "<rootDir>/libs/billing/src/$1",
      "^@hichandra/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@hichandra/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@hichandra/dtos(|/.*)$": "<rootDir>/libs/dtos/src/$1",
      "^@hichandra/email-services(|/.*)$": "<rootDir>/libs/email-services/src/$1",
      "^@hichandra/repositories(|/.*)$": "<rootDir>/libs/repositories/src/$1",
      "^@hichandra/s3(|/.*)$": "<rootDir>/libs/s3/src/$1",
      "^@hichandra/gateway(|/.*)$": "<rootDir>/libs/gateway/src/$1",
      "^@hichandra/payment(|/.*)$": "<rootDir>/libs/payment/src/$1"
    }
  }
}
